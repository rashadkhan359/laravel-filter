{
    "name": "rashadkhan359/laravel-filter",
    "description": "A modern and advanced package to filter models in laravel.",
    "type": "library",
    "autoload": {
        "psr-4": {
            "RashadKhan\\LaravelFilter\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Rashad Khan",
            "email": "rashadkhan359@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^11.0|^10.0|^9.0|^8.0|^12.0"
    },
    "require-dev": {
        "mongodb/laravel-mongodb": "^4.2"
    },
    "keywords": [
        "php",
        "github",
        "laravel",
        "Open Source",
        "filter",
        "query",
        "mongo",
        "generator",
        "command",
        "laravel 8",
        "laravel 9",
        "laravel 10",
        "laravel 11",
        "laravel 12"
    ],
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "RashadKhan\\LaravelFilter\\LaravelFilterProvider"
            ]
        }
    }
}
